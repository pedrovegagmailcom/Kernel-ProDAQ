<Window x:Class="ProDAQConfig.CellConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de CellConfig"
        Width="720"
        Height="620"
        Background="#0B1120"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#111827"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryAccentDarkBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280"/>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Margin="6,2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryAccentDarkBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#374151"/>
                    <Setter Property="BorderBrush" Value="#4B5563"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F2937"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="6,0,6,6" VerticalAlignment="Center">
            <TextBlock Text="Gestión de configuración de la célula"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="16"
                       FontWeight="SemiBold"/>
            <TextBlock Text=" — leer, editar y grabar los parámetros almacenados en el kernel"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="6,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <UniformGrid Columns="2" Rows="7" Margin="0,6,0,0" HorizontalAlignment="Stretch">
                        <StackPanel Margin="6">
                            <TextBlock Text="Número de serie" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Text="{Binding CurrentConfig.SerialNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="6">
                            <TextBlock Text="Capacidad" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Text="{Binding CurrentConfig.Capacity, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="6">
                            <TextBlock Text="Límite" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Text="{Binding CurrentConfig.Limit, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="6">
                            <TextBlock Text="Resolución" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Text="{Binding CurrentConfig.Resolution, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="6">
                            <TextBlock Text="x1t" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Text="{Binding CurrentConfig.X1T, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="6">
                            <TextBlock Text="x2t" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Text="{Binding CurrentConfig.X2T, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="6">
                            <TextBlock Text="x3t" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Text="{Binding CurrentConfig.X3T, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="6">
                            <TextBlock Text="x4t" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Text="{Binding CurrentConfig.X4T, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="6">
                            <TextBlock Text="x1c" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Text="{Binding CurrentConfig.X1C, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="6">
                            <TextBlock Text="x2c" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Text="{Binding CurrentConfig.X2C, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="6">
                            <TextBlock Text="x3c" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Text="{Binding CurrentConfig.X3C, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="6">
                            <TextBlock Text="x4c" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Text="{Binding CurrentConfig.X4C, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="6">
                            <TextBlock Text="Overload tracción" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Text="{Binding CurrentConfig.OverloadT, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="6">
                            <TextBlock Text="Overload compresión" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Text="{Binding CurrentConfig.OverloadC, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Orientation="Horizontal" Margin="4,12,4,0">
                        <Button Content="Leer del kernel"
                                Style="{StaticResource SecondaryButtonStyle}"
                                IsEnabled="{Binding IsNotBusy}"
                                Click="ReadButton_OnClick"/>
                        <Button Content="Guardar en kernel"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="{Binding IsNotBusy}"
                                Click="SaveButton_OnClick"/>
                        <Button Content="Cerrar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="CloseButton_OnClick"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Background="#020617"
                Padding="8"
                CornerRadius="6"
                Margin="10,0,10,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource TextMutedBrush}"/>
        </Border>
    </Grid>
</Window>
