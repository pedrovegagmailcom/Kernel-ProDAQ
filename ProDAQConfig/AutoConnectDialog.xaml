<Window x:Class="ProDAQConfig.AutoConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conexión automática"
        Width="360"
        Height="160"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0B1120"
        FontFamily="Segoe UI"
        FontSize="12"
        ShowInTaskbar="False">
    <Border Margin="12"
            Padding="12"
            Background="#111827"
            BorderBrush="#1F2937"
            BorderThickness="1"
            CornerRadius="8">
        <StackPanel>
            <TextBlock Text="Buscando la electrónica..."
                       Foreground="#F9FAFB"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>
            <TextBlock TextWrapping="Wrap"
                       Text="{Binding ProgressMessage}"
                       Foreground="#9CA3AF"
                       Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        Width="90"
                        Click="CancelButton_OnClick"
                        Background="#111827"
                        BorderBrush="#4B5563"
                        Foreground="#F9FAFB"
                        Padding="6,3"
                        Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
