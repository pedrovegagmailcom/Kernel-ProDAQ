<Window x:Class="ProDAQConfig.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de ProDAQ"
        Width="1100"
        Height="800"
        Background="#0B1120"
        FontFamily="Segoe UI"
        FontSize="12">
    <Window.Resources>

        <!-- Colores base -->
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#111827"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="PrimaryAccentDarkBrush" Color="#1D4ED8"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F9FAFB"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7280"/>

        <!-- Colores alarmas -->
        <SolidColorBrush x:Key="AlarmOkBrush" Color="#16A34A"/>
        <!-- Verde -->
        <SolidColorBrush x:Key="AlarmActiveBrush" Color="#DC2626"/>
        <!-- Rojo -->
        <SolidColorBrush x:Key="AlarmBackgroundBrush" Color="#111827"/>

        <!-- Estilo de tarjeta -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <!-- Botones principales -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryAccentDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Margin="6,2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryAccentDarkBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#374151"/>
                    <Setter Property="BorderBrush" Value="#4B5563"/>
                    <Setter Property="Foreground" Value="#9CA3AF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botones secundarios -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1F2937"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Títulos de bloque -->
        <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Valores grandes -->
        <Style x:Key="BigValueTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Barra conexión -->
            <RowDefinition Height="*"/>
            <!-- Contenido principal -->
            <RowDefinition Height="Auto"/>
            <!-- Estado inferior -->
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR: CONEXIÓN -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Puerto" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="120"
                              ItemsSource="{Binding AvailablePorts}"
                              SelectedItem="{Binding SelectedPort}"
                              Margin="0,0,8,0"/>

                    <Button Content="Actualizar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="RefreshPortsButton_Click"/>

                    <Button Content="Conectar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="ConnectButton_Click"
                            Margin="8,0,0,0"/>

                    <Button Content="Desconectar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="DisconnectButton_Click"
                            Margin="4,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Vertical"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,4,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource AlarmActiveBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CommunicationHealthy}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource AlarmOkBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding CommunicationStatus}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <TextBlock Margin="0,2,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <Run Text="Data rate: "/>
                        <Run Text="{Binding DataRateStatus, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TELEMETRÍA + ALARMAS -->
            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                   

                    <!-- Fuerza / Posición -->
                    <Grid Grid.Row="1" Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Fuerza -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Fuerza (R1)"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding ForceReading}"
                                           Style="{StaticResource BigValueTextStyle}"/>
                                <!-- Si quieres kN, puedes añadir un TextBlock aquí -->
                            </StackPanel>
                            <Button Content="Cero fuerza"
                                    Width="100"
                                    Margin="0,6,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ZeroForceButton_Click"/>
                        </StackPanel>

                        <!-- Posición -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Posición (R2)"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding EncoderReading}"
                                           Style="{StaticResource BigValueTextStyle}"/>
                                <TextBlock Text=" mm"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="16"
                                           Margin="4,6,0,0"/>
                            </StackPanel>
                            <Button Content="Cero encoder"
                                    Width="110"
                                    Margin="0,6,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="ZeroEncoderButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Barra resumen de alarmas -->
                    <Border Grid.Row="2"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource AlarmOkBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveAlarms}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AlarmActiveBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="White" Margin="0,0,6,0"/>
                            <TextBlock Foreground="White" FontWeight="SemiBold">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}ALARMAS ACTIVAS: {0}">
                                        <Binding Path="ActiveAlarmCount"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Detalle estilo "pilotos" -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Columna izquierda -->
                        <StackPanel Grid.Column="0">
                            <!-- Motor -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="3" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource AlarmOkBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AlarmMotorActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AlarmActiveBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Motor"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Compresor -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="3" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource AlarmOkBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AlarmCompresorActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AlarmActiveBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Compresor"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- FCI -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="3" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource AlarmOkBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AlarmFCIActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AlarmActiveBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="FCI"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Tracción -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="3" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource AlarmOkBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AlarmTraccionActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AlarmActiveBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Tracción"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>

                        <!-- Columna derecha -->
                        <StackPanel Grid.Column="1">
                            <!-- FCS -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="3" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource AlarmOkBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AlarmFCSActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AlarmActiveBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="FCS"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Seta -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="3" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource AlarmOkBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AlarmSetaActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AlarmActiveBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Seta"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Cero -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="3" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource AlarmOkBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AlarmCeroActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AlarmActiveBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Cero"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Célula -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="3" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource AlarmOkBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AlarmCelulaActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AlarmActiveBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="Célula"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- CONTROL MANUAL -->
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Control manual"
                               Style="{StaticResource SectionTitleTextStyle}"/>

                    <StackPanel HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="▲"
                                FontSize="30"
                                Width="80"
                                Height="50"
                                Margin="0,0,0,6"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="MoveUpButton_Click"/>
                        <Button Content="■"
                                FontSize="30"
                                Width="80"
                                Height="50"
                                Margin="0,0,0,6"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="StopButton_Click"/>
                        <Button Content="▼"
                                FontSize="30"
                                Width="80"
                                Height="50"
                                Margin="0,0,0,6"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="MoveDownButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- CONFIGURACIÓN ENCODER -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Configuración del encoder"
                               Style="{StaticResource SectionTitleTextStyle}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Ganancia (pasos/mm):"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,6,0"/>
                        <TextBox Width="80"
                                 Text="{Binding EncoderGain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,6,0"/>
                        <Button Content="Aplicar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ApplyEncoderGainButton_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <CheckBox Content="Invertir lectura"
                                  IsChecked="{Binding IsEncoderInverted, Mode=TwoWay}"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center"/>
                        <Button Content="Aplicar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                Click="ApplyEncoderPolarityButton_OnClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- VELOCIDAD ENSAYO -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Velocidad de ensayo"
                               Style="{StaticResource SectionTitleTextStyle}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Velocidad (mm/min):"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,6,0"/>
                        <TextBox Width="80"
                                 Text="{Binding SpeedSetpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,6,0"/>
                        <Button Content="Aplicar"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="ApplySpeedSetpointButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- AJUSTE OFFSET ANALÓGICO -->
            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Ajuste de salida analógica"
                               Style="{StaticResource SectionTitleTextStyle}"/>

                    <TextBlock Text="Offset (V):"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Control basto"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Slider Width="300"
                                    Minimum="-1"
                                    Maximum="1"
                                    Value="{Binding CoarseOffsetValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TickFrequency="0.05"
                                    IsSnapToTickEnabled="True"/>
                            <TextBlock Text="Control fino (±0,1 V)"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Slider Width="300"
                                    Minimum="-0.1"
                                    Maximum="0.1"
                                    Value="{Binding FineOffsetAdjustment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TickFrequency="0.005"
                                    IsSnapToTickEnabled="True"/>
                        </StackPanel>

                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Valor basto"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding CoarseOffsetValue, StringFormat=F3}"
                                       Style="{StaticResource BigValueTextStyle}"/>
                            <TextBlock Text="Ajuste fino"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding FineOffsetAdjustment, StringFormat=F3}"
                                       Style="{StaticResource BigValueTextStyle}"/>
                        </StackPanel>

                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Offset total"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding OffsetValue, StringFormat=F3}"
                                       Style="{StaticResource BigValueTextStyle}"/>
                            <Button Content="Aplicar"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Margin="0,6,0,0"
                                    Click="ApplyOffsetButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Botón lecturas manuales -->
            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Lecturas"
                               Style="{StaticResource SectionTitleTextStyle}"/>
                    <Button Content="Actualizar lecturas"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="160"
                            Click="ReadTelemetryButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- BARRA INFERIOR -->
        <Border Grid.Row="2"
                Background="#020617"
                Padding="6"
                Margin="10,0,10,0"
                CornerRadius="6">
            <TextBlock Text="{Binding AlarmStatus}"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
