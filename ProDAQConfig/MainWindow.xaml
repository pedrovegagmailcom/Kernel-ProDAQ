<Window x:Class="ProDAQConfig.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProDAQConfig"
        mc:Ignorable="d"
        Title="ProDAQ Config" Height="800" Width="900">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Configuración de ProDAQ" FontSize="24" FontWeight="Bold" />

        <!-- Conexión serie -->
        <GroupBox Grid.Row="1" Header="Conexión" Margin="0,12,0,0">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Puerto" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="PortsComboBox"
                          Grid.Column="1"
                          ItemsSource="{Binding AvailablePorts}"
                          SelectedItem="{Binding SelectedPort, Mode=TwoWay}"
                          MinWidth="160" />
                <Button Grid.Column="2" Content="Actualizar" Margin="8,0" Padding="12,4" Click="RefreshPortsButton_Click" />
                <Button Grid.Column="3" Content="Conectar" Margin="8,0" Padding="12,4" Click="ConnectButton_Click" />
                <Button Grid.Column="4" HorizontalAlignment="Left" Content="Desconectar" Padding="12,4" Click="DisconnectButton_Click" />

                <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding StatusMessage}" Foreground="Gray" Margin="0,12,0,0" />
            </Grid>
        </GroupBox>

        <!-- Lecturas -->
        <Grid Grid.Row="2" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Header="Telemetría" Grid.Column="0" Margin="0,0,12,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Lectura de fuerza (R1):" FontWeight="Bold"  FontSize="14"/>
                    <TextBlock Grid.Column="1" Text="{Binding ForceReading}" />
                    <Button Grid.Column="2"
                            Content="0"
                            Width="28"
                            Height="28"
                            Margin="8,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Click="ZeroForceButton_Click" />

                    <TextBlock Grid.Row="1" Text="Lectura del encoder (R2):" FontWeight="Bold" FontSize="14" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EncoderReading}" />
                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Content="0"
                            Width="28"
                            Height="28"
                            Margin="8,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Click="ZeroEncoderButton_Click" />

                    <TextBlock Grid.Row="2" Text="Estado alarmas:" FontWeight="Bold" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AlarmStatus}" TextWrapping="Wrap" FontSize="14" Grid.ColumnSpan="2"/>

                    <Button Grid.Row="3" Grid.ColumnSpan="3" Content="Actualizar lecturas" Margin="0,12,0,0" Padding="12,4" HorizontalAlignment="Left" Click="ReadTelemetryButton_Click" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Control manual" Grid.Column="1">
                <StackPanel Margin="12" VerticalAlignment="Center">
                    <Button Padding="16,8" Margin="0,0,0,8" Width="100" Height="30"
                            ToolTip="Subir"
                            Click="MoveUpButton_Click"
                            IsEnabled="{Binding IsConnected}">
                        <TextBlock Text="▲" FontSize="10" HorizontalAlignment="Center" />
                    </Button>
                    <Button Padding="16,8" Margin="0,0,0,8" Width="100" Height="30"
                        ToolTip="Parar"
                        Click="StopButton_Click"
                        IsEnabled="{Binding IsConnected}">
                        <TextBlock Text="■" FontSize="10" HorizontalAlignment="Center" />
                    </Button>
                    <Button Padding="16,8"  Width="100" Height="30"
                            ToolTip="Bajar"
                            Click="MoveDownButton_Click"
                            IsEnabled="{Binding IsConnected}">
                        <TextBlock Text="▼" FontSize="10" HorizontalAlignment="Center" />
                    </Button>
                    
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Offset -->
        <GroupBox Grid.Row="3" Header="Ganancia del encoder">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="pasos por mm" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Width="120" HorizontalContentAlignment="Right"
                         Text="{Binding EncoderGain, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F4}" />
                <Button Grid.Column="2" Content="Aplicar" Margin="12,0" Padding="16,8" VerticalAlignment="Center"
                        Click="ApplyEncoderGainButton_Click" />
                <TextBlock Grid.Column="3" Text="El valor se envía al kernel; la telemetría del encoder ya llegará en milímetros." TextWrapping="Wrap" Margin="12,0,0,0" />

                <TextBlock Grid.Row="1" Text="Polaridad" VerticalAlignment="Center" />
                <CheckBox Grid.Row="1" Grid.Column="1" Content="Invertir lectura"
                          IsChecked="{Binding IsEncoderInverted, Mode=TwoWay}" />
                <Button Grid.Row="1" Grid.Column="2" Content="Aplicar" Margin="12,8,12,0" Padding="16,8"
                        VerticalAlignment="Center" Click="ApplyEncoderPolarityButton_OnClick" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="Permite invertir el signo de la lectura del encoder para adaptarse a distintas máquinas." TextWrapping="Wrap" Margin="12,8,0,0" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="Consigna de velocidad">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Velocidad (mm/min)" VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Width="120"
                         HorizontalContentAlignment="Right"
                         Text="{Binding SpeedSetpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F1}" />
                <Button Grid.Column="2"
                        Content="Aplicar"
                        Margin="12,0"
                        Padding="16,8"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding IsConnected}"
                        Click="ApplySpeedSetpointButton_Click" />
                <TextBlock Grid.Column="3"
                           Text="Se envía el comando WV al kernel (máx. 500 mm/min)."
                           TextWrapping="Wrap"
                           Margin="12,0,0,0" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="5" Header="Ajuste de offset de salida analógica">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Offset (V)" FontWeight="SemiBold" />
                    <Slider Minimum="-5" Maximum="5" TickFrequency="0.1" IsSnapToTickEnabled="True"
                            Value="{Binding OffsetValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="Valor" FontWeight="SemiBold" />
                    <TextBox Width="100" HorizontalContentAlignment="Right"
                             Text="{Binding OffsetValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" />
                </StackPanel>

                <Button Grid.Column="2" Content="Aplicar" Padding="16,8" VerticalAlignment="Center"
                        Click="ApplyOffsetButton_Click" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>
